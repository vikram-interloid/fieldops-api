// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @db.VarChar(150)
  industry  String?  @db.VarChar(100)
  // Account kind:
  //  - 'platform': the FieldOps control-plane tenant (staff manage everything)
  //  - 'customer': a brand/client that owns sites & assets and raises cases
  //  - 'operator': a service company that hires technicians & covers areas
  // 'customer'/'operator' are chosen at registration; 'platform' is seeded.
  type       String   @default("customer") @db.VarChar(20)
  // Onboarding verification: self-registered customer/operator orgs start
  // 'pending' and a platform admin reviews their location before 'verified'.
  // 'rejected' blocks them. The seeded platform org is 'verified'.
  verificationStatus String    @default("pending") @map("verification_status") @db.VarChar(20)
  verifiedAt         DateTime? @map("verified_at")
  verificationNote   String?   @map("verification_note") @db.VarChar(300)
  // Operator profile (only meaningful when type = 'operator').
  categories String[] @default([])
  region     String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  locations Location[]

  customers     Customer[]
  technicians   Technician[]
  assets        Asset[]
  parts         Part[]
  workOrders    WorkOrder[]
  serviceCases  ServiceCase[]
  notifications Notification[]
  slaPolicies   SlaPolicy[]
  operators     Operator[]
  serviceAreas  ServiceArea[]

  @@map("organizations")
}

model Operator {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId       String      @map("organization_id")@db.Uuid
  tenantOrganizationId String?     @map("tenant_organization_id") @db.Uuid
  name                 String   @db.VarChar(150)
  categories           String[] // vending | coffee | hvac | refrigeration | electrical | general
  status               String   @default("Active") @db.VarChar(30)
  contactName          String?  @map("contact_name") @db.VarChar(150)
  email                String?  @db.VarChar(150)
  phone                String?  @db.VarChar(30)
  rating               Float    @default(0)
  region               String?  @db.VarChar(80)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  serviceAreas ServiceArea[]
  workOrders   WorkOrder[]
  serviceCases ServiceCase[]

  @@map("operators")
}

model ServiceArea {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  operatorId     String      @map("operator_id") @db.Uuid
  category       String   @db.VarChar(40)
  region         String?  @db.VarChar(80)
  postalPrefix   String?  @map("postal_prefix") @db.VarChar(12)
  lat            Float?
  lng            Float?
  radiusKm       Float?   @map("radius_km")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  operator     Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@map("service_areas")
}

model SlaPolicy {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  priority          String   @db.VarChar(20) // Low | Medium | High | Critical
  responseMinutes   Int      @map("response_minutes")
  resolutionMinutes Int      @map("resolution_minutes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, priority])
  @@map("sla_policies")
}

model Location {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  type           String   @default("customer_site") @db.VarChar(30) 
  name           String   @db.VarChar(150)
  address        String?  @db.VarChar(200)
  city           String?  @db.VarChar(100)
  region         String?  @db.VarChar(80)
  state          String?  @db.VarChar(100)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  country        String?  @db.VarChar(100)
  lat            Float?
  lng            Float?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveryPoints DeliveryPoint[]
  assets         Asset[]
  workOrders     WorkOrder[]

  @@map("locations")
}

model DeliveryPoint {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId   String      @map("location_id") @db.Uuid
  name         String   @db.VarChar(150)
  contactName  String?  @map("contact_name") @db.VarChar(150)
  contactPhone String?  @map("contact_phone") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assets   Asset[]

  @@map("delivery_points")
}

model User {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  email          String   @unique @db.VarChar(150)
  phone          String?  @db.VarChar(20)
  passwordHash   String   @map("password_hash") @db.VarChar(100)
  organizationId String      @map("organization_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  technicianId   String?     @map("technician_id") @db.Uuid
  tokenVersion   Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  // True for the org's owner/admin (the registrant). Gates org-user management
  // for customer/operator tenants; plain members can view but not mutate.
  isOrgAdmin     Boolean  @default(false) @map("is_org_admin")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  technician    Technician?    @relation(fields: [technicianId], references: [id])
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Role {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String?

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  roleId     String      @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId String  @map("user_id") @db.Uuid
  user   User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  userId String  @map("user_id") @db.Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
}
model EmailOtp {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email      String
  purpose    OtpPurpose
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at") 
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([email, purpose])
  @@map("email_otps")
}

model Customer {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String   @db.VarChar(150)
  contactName    String   @map("contact_name") @db.VarChar(150)
  email          String   @db.VarChar(150)
  phone          String   @db.VarChar(30)
  industry       String   @db.VarChar(60)
  contractType   String   @map("contract_type") @db.VarChar(40)
  status         String   @db.VarChar(30)
  city           String?  @db.VarChar(100)
  address        String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  locations    Location[]
  assets       Asset[]
  workOrders   WorkOrder[]
  serviceCases ServiceCase[]
  users        User[]

  @@map("customers")
}

model Technician {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String   @db.VarChar(150)
  role           String   @db.VarChar(80)
  status         String   @db.VarChar(30)
  activeJobs     Int      @default(0) @map("active_jobs")
  rating         Float    @default(0)
  skills         String[]
  email          String?  @db.VarChar(150)
  phone          String?  @db.VarChar(30)
  employeeId     String?  @map("employee_id") @db.VarChar(40)
  region         String?  @db.VarChar(40)
  department     String?  @db.VarChar(40)
  hireDate       String?  @map("hire_date") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  workOrders   WorkOrder[]
  users        User[]
  events       TechnicianEvent[]

  @@map("technicians")
}

model Asset {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  name            String   @db.VarChar(150)
  serial          String   @db.VarChar(120)
  customerId      String?     @map("customer_id") @db.Uuid
  health          Int      @default(100)
  warranty        String   @db.VarChar(30)
  status          String   @db.VarChar(30)
  category        String?  @db.VarChar(40)
  manufacturer    String?  @db.VarChar(120)
  model           String?  @db.VarChar(120)
  location        String?  @db.VarChar(200)
  purchaseDate    String?  @map("purchase_date") @db.VarChar(40)
  lastServiceDate String?  @map("last_service_date") @db.VarChar(40)
  nextServiceDate String?  @map("next_service_date") @db.VarChar(40)
  notes           String?
  photoUrl        String?  @map("photo_url") @db.VarChar(500)
  locationId      String?     @map("location_id") @db.Uuid
  deliveryPointId String?     @map("delivery_point_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  site          Location?      @relation(fields: [locationId], references: [id])
  deliveryPoint DeliveryPoint? @relation(fields: [deliveryPointId], references: [id])
  workOrders    WorkOrder[]

  @@map("assets")
}

model Part {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String   @db.VarChar(150)
  sku            String   @db.VarChar(80)
  category       String   @db.VarChar(40)
  location       String   @db.VarChar(40)
  quantity       Int      @default(0)
  reorderLevel   Int      @default(0) @map("reorder_level")
  unitPrice      Float    @default(0) @map("unit_price")
  supplier       String?  @db.VarChar(150)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("parts")
}

model WorkOrder {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  technicianId   String?     @map("technician_id") @db.Uuid
  assetId        String?     @map("asset_id") @db.Uuid
  priority       String   @db.VarChar(20)
  status         String   @db.VarChar(20)
  serviceType    String?  @map("service_type") @db.VarChar(40)
  location       String?  @db.VarChar(200)
  contactName    String?  @map("contact_name") @db.VarChar(150)
  contactPhone   String?  @map("contact_phone") @db.VarChar(30)
  contactEmail   String?  @map("contact_email") @db.VarChar(150)
  due            String   @db.VarChar(40)
  scheduledDate  String?  @map("scheduled_date") @db.VarChar(40)
  estimatedHours Float?   @map("estimated_hours")
  description    String?
  accepted       Boolean  @default(false)
  locationId     String?     @map("location_id") @db.Uuid
  lat            Float?
  lng            Float?
  // SLA tracking
  respondedAt    DateTime? @map("responded_at")
  resolvedAt     DateTime? @map("resolved_at")
  slaPausedAt    DateTime? @map("sla_paused_at")
  slaPausedMs    Int       @default(0) @map("sla_paused_ms")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  operatorId     String?     @map("operator_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  technician   Technician?  @relation(fields: [technicianId], references: [id])
  asset        Asset?       @relation(fields: [assetId], references: [id])
  site         Location?    @relation(fields: [locationId], references: [id])
  operator     Operator?    @relation(fields: [operatorId], references: [id])
  serviceCase  ServiceCase?
  events       WorkOrderEvent[]

  @@map("work_orders")
}

model WorkOrderEvent {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workOrderId String      @map("work_order_id") @db.Uuid
  // created | status_changed | assigned_technician | accepted |
  // assigned_operator | updated
  type        String   @db.VarChar(40)
  fromValue   String?  @map("from_value") @db.VarChar(150)
  toValue     String?  @map("to_value") @db.VarChar(150)
  note        String?
  actorId     String?     @map("actor_id") @db.Uuid
  actorName   String?  @map("actor_name") @db.VarChar(150)
  actorRole   String?  @map("actor_role") @db.VarChar(40)
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_events")
}
model ServiceCaseEvent {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serviceCaseId String      @map("service_case_id") @db.Uuid
  // created | status_changed | operator_interest | operator_assigned |
  // converted | updated
  type          String   @db.VarChar(40)
  fromValue     String?  @map("from_value") @db.VarChar(150)
  toValue       String?  @map("to_value") @db.VarChar(150)
  note          String?
  actorId       String?     @map("actor_id") @db.Uuid
  actorName     String?  @map("actor_name") @db.VarChar(150)
  actorRole     String?  @map("actor_role") @db.VarChar(40)
  createdAt     DateTime @default(now()) @map("created_at")

  serviceCase ServiceCase @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)

  @@index([serviceCaseId])
  @@map("service_case_events")
}

model TechnicianEvent {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  technicianId String      @map("technician_id") @db.Uuid
  // created | updated | status_changed
  type         String   @db.VarChar(40)
  fromValue    String?  @map("from_value") @db.VarChar(150)
  toValue      String?  @map("to_value") @db.VarChar(150)
  note         String?
  actorId      String?     @map("actor_id") @db.Uuid
  actorName    String?  @map("actor_name") @db.VarChar(150)
  actorRole    String?  @map("actor_role") @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at")

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId])
  @@map("technician_events")
}

model ServiceCase {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  subject        String   @db.VarChar(200)
  description    String
  serviceType    String   @map("service_type") @db.VarChar(40)
  priority       String   @db.VarChar(20)
  location       String   @db.VarChar(200)
  status         String   @db.VarChar(20)
  category       String?  @db.VarChar(40)
  locationId     String?     @map("location_id") @db.Uuid
  operatorId     String?     @map("operator_id") @db.Uuid
  // Customer's preferred operator — an Operator *directory record* id, a soft
  // hint surfaced to dispatch.
  preferredOperatorId  String?  @map("preferred_operator_id") @db.Uuid
  // Operator *organization* ids (tenants, type='operator') that opted in to
  // service this case, and the one a platform dispatcher finally assigned.
  interestedOperatorIds String[] @default([]) @map("interested_operator_ids")
  assignedOperatorOrgId String?  @map("assigned_operator_org_id") @db.Uuid
  workOrderId    String?     @unique @map("work_order_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  operator     Operator?    @relation(fields: [operatorId], references: [id])
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id])
  events       ServiceCaseEvent[]

  @@map("service_cases")
}

model Notification {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  title          String   @db.VarChar(200)
  message        String
  type           String   @db.VarChar(20)
  read           Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("notifications")
}
